<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zjj.netdisk.mapper.PhysicalFilesMapper">

    <resultMap id="BaseResultMap" type="com.zjj.netdisk.entity.PhysicalFiles">
            <id property="fileHash" column="file_hash" />
            <result property="fileSizeBytes" column="file_size_bytes" />
            <result property="storagePath" column="storage_path" />
            <result property="referenceCount" column="reference_count" />
            <result property="creationTs" column="creation_ts" />
    </resultMap>

    <sql id="Base_Column_List">
        file_hash,file_size_bytes,storage_path,reference_count,creation_ts
    </sql>
</mapper>
